# GovernBot Core - Configuration (no secrets in this file)
# Copy to .env and set values. In Databricks, set env from job parameters or secrets.

# Governance catalog and schema (Unity Catalog location for governance tables)
GOVERNANCE_CATALOG=
GOVERNANCE_SCHEMA=sch_mng_admon

# Authentication: azure-client-secret | pat
AUTH_TYPE=azure-client-secret

# Key Vault / Secret scope and key names (secret values go in Databricks secrets or env)
KV_SCOPE=
KV_CLIENT_ID_KEY=
KV_CLIENT_SECRET_KEY=
KV_TENANT_ID_KEY=
# Optional: second PAT key for additional workspaces
KV_CLIENT_SECRET_KEY2=

# Account-level API (optional)
ACCOUNT_URL=https://accounts.azuredatabricks.net/
ACCOUNT_ID=

# Optional: workspace_id -> catalog overrides as JSON (e.g. {"4126527463676543": "qadl"})
# If not set, GOVERNANCE_CATALOG is used for all workspaces.
WORKSPACE_CATALOG_OVERRIDES=

# Default lookback hours for audit log queries
LOOKBACK_HOURS_DEFAULT=24

# Optional: comma-separated object types to exclude from tracking (opt-out)
# GOVERNANCE_EXCLUDED_OBJECT_TYPES=cluster,instancePool

# Optional: workspace IDs that use KV_CLIENT_SECRET_KEY2 for PAT (comma-separated)
# WORKSPACE_IDS_USE_PAT_KEY2=2535844015940567
